{
  "name": "@soundscape/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Soundscape — immersive music visualizer (desktop)",
  "author": "mracette",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
