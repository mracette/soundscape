{
  "name": "soundscape",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chroma-js": "2.1.2",
    "color-curves": "0.0.7",
    "d3-color": "3.0.1",
    "d3-ease": "3.0.1",
    "d3-scale-chromatic": "3.0.0",
    "gsap": "3.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stats.js": "0.17.0",
    "three": "npm:three@0.185.0",
    "three-legacy": "npm:three@0.108.0",
    "wouter": "3.10.0",
    "zustand": "5.0.14"
  },
  "scripts": {
    "start": "vite",
    "stems": "vite --open /stem-inspector.html",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "test:e2e": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test",
    "test:blender": "for f in tools/blender/tests/test_*.py; do out=$(\"${BLENDER_BIN:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --python \"$f\" 2>&1); echo \"$out\"; echo \"$out\" | grep -q '^OK ' || { echo \"FAILED: $f\"; exit 1; }; done",
    "bake:song": "node tools/bake-song.mjs",
    "test:bake": "node tools/blender/bake/test-bake-audio.mjs && node tools/test-bake-song.mjs",
    "test:bridge": "python3 tools/blender/bake/test-bake-bridge.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/chroma-js": "^3.1.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@types/three-legacy": "npm:@types/three@0.103.2",
    "@vanilla-extract/css": "1.20.1",
    "@vanilla-extract/vite-plugin": "5.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.8.0"
}
